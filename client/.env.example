# Frontend Client Environment Configuration Example
# Copy this file to .env or .env.production when customizing client builds

# Set the backend API URL when deploying frontend and backend to separate domains (e.g. Vercel + Render)
# Example: https://madhav-portfolio-api.onrender.com
# If left empty in production, the client will make relative requests ('') to the same origin.
VITE_API_BASE_URL=http://localhost:5000
