# ==========================================
# Server Network & Runtime Configuration
# ==========================================
PORT=5000
NODE_ENV=development

# ==========================================
# CORS Whitelist Configuration
# ==========================================
# For local development with Vite:
CLIENT_URL=http://localhost:5173

# For production deployment (supports multiple comma-separated URLs):
# ALLOWED_ORIGINS=https://madhav-portfolio.vercel.app,https://yourdomain.com

# ==========================================
# MongoDB Database Connection
# ==========================================
# Option A - Local MongoDB Instance:
MONGODB_URI=mongodb://localhost:27017/madhav_portfolio

# Option B - MongoDB Atlas Cloud Cluster:
# MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-name>.mongodb.net/madhav_portfolio?retryWrites=true&w=majority
